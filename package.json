{
  "name": "packages-for-work",
  "version": "1.0.0",
  "description": "Monorepo to temporarily host some packages for work until we set up our new Org",
  "type": "module",
  "scripts": {
    "build": "nx run-many --target=build --exclude=@mikesprague/package-starter,@mikesprague/ct-azure",
    "clean": "nx run-many --target=clean --exclude=@mikesprague/package-starter,@mikesprague/ct-azure",
    "format": "nx run-many --target=format --exclude=@mikesprague/package-starter,@mikesprague/ct-azure",
    "format:check": "nx run-many --target=format:check --exclude=@mikesprague/package-starter,@mikesprague/ct-azure",
    "lint": "npm run oxlint && npm run typecheck",
    "oxlint": "nx run-many --target=lint --exclude=@mikesprague/package-starter,@mikesprague/ct-azure",
    "release": "nx release",
    "release:dry-run": "npm run release -- --dry-run",
    "release:version": "nx release version",
    "release:changelog": "nx release changelog",
    "release:publish": "nx release publish",
    "test": "npm run lint && npm run vitest:coverage -- --silent",
    "typecheck": "nx run-many --target=typecheck --exclude=@mikesprague/package-starter,@mikesprague/ct-azure",
    "vitest": "vitest run",
    "vitest:watch": "vitest run --watch",
    "vitest:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">= 26.x",
    "npm": ">= 12.x"
  },
  "packageManager": "npm@12.2.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/mikesprague/packages-for-work.git"
  },
  "author": {
    "name": "Michael Sprague",
    "email": "mikesprague@gmail.com"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mikesprague/packages-for-work/issues"
  },
  "homepage": "https://github.com/mikesprague/packages-for-work#readme",
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@nx/js": "24.0.4",
    "@nx/vite": "24.0.5",
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.16.22",
    "@swc/helpers": "0.5.24",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "cz-git": "1.14.0",
    "documentation": "14.0.3",
    "nx": "24.0.4",
    "oxfmt": "0.77.0",
    "oxlint": "1.91.0",
    "rimraf": "6.1.4",
    "tsdown": "0.23.7",
    "typedoc": "0.28.20",
    "typescript": "npm:@typescript/typescript6@6.0.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "vitest": "5.1.0"
  },
  "overrides": {
    "axios": "^1.21.0",
    "brace-expansion": "^5.0.12",
    "smol-toml": "^1.9.1",
    "uuid": "^14.0.3",
    "vue-template-compiler": "^3.0.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-git"
    }
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "@swc/core@1.16.21": true,
    "nx@24.0.4": true
  }
}
